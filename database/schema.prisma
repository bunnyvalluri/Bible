// Prisma Schema for Vachanam Multilingual Bible Engine
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Book {
  id            Int       @id
  code          String    @unique // e.g. GEN, MAT, PSA
  shortCode     String    // e.g. Gen, Matt, Ps
  english       String
  telugu        String
  hindi         String
  testament     String    // OT or NT
  chaptersCount Int
  category      String    // Law, History, Poetry, Gospels, etc.
  orderIndex    Int       @default(0)

  chapters      Chapter[]
  verses        Verse[]

  @@index([code])
  @@index([testament])
}

model Chapter {
  id            Int      @id @default(autoincrement())
  bookId        Int
  chapterNumber Int
  totalVerses   Int      @default(0)

  book          Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  verses        Verse[]
  audios        Audio[]

  @@unique([bookId, chapterNumber])
  @@index([bookId, chapterNumber])
}

model Verse {
  id            Int           @id @default(autoincrement())
  verseKey      String        @unique // e.g. GEN.1.1, JHN.3.16
  bookId        Int
  chapterId     Int?
  chapterNumber Int
  verseNumber   Int
  textTelugu    String
  textEnglish   String
  textHindi     String

  book          Book          @relation(fields: [bookId], references: [id], onDelete: Cascade)
  chapter       Chapter?      @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  explanations  Explanation[]
  images        VerseImage[]
  audios        Audio[]
  illustrations Illustration[]

  @@index([bookId, chapterNumber, verseNumber])
  @@index([verseKey])
}

model Explanation {
  id                 Int      @id @default(autoincrement())
  verseId            Int?
  verseKey           String
  language           String   // en, te, hi
  simpleExplanation  String
  keyPoints          String   // JSON array of 3 key learning points
  historicalContext  String
  spiritualMeaning   String
  lifeApplication    String
  youthExplanation   String
  aiModel            String   @default("gpt-4o-mini")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  verse              Verse?   @relation(fields: [verseId], references: [id], onDelete: Cascade)

  @@unique([verseKey, language])
  @@index([verseKey])
}

model Diagram {
  id          Int      @id @default(autoincrement())
  diagramKey  String   @unique
  bookCode    String
  chapter     Int?
  verses      String?
  titleEn     String
  titleTe     String?
  titleHi     String?
  type        String   // flowchart, timeline, relationship, infographic, mindmap, concept, journey
  data        String   // JSON structured nodes & links
  createdAt   DateTime @default(now())

  @@index([bookCode])
  @@index([type])
}

model VerseImage {
  id              Int      @id @default(autoincrement())
  verseId         Int?
  verseKey        String
  imageUrl        String
  prompt          String
  style           String   @default("biblical-oil-painting")
  resolution      String   @default("1920x1080")
  storageProvider String   @default("cloudinary") // cloudinary, s3, local
  createdAt       DateTime @default(now())

  verse           Verse?   @relation(fields: [verseId], references: [id], onDelete: Cascade)

  @@index([verseKey])
}

model Audio {
  id              Int      @id @default(autoincrement())
  verseId         Int?
  chapterId       Int?
  verseKey        String?  // null for full chapter audio
  language        String   // en, te, hi
  audioUrl        String
  durationSeconds Float    @default(0)
  storageProvider String   @default("s3") // s3, gcs, local
  createdAt       DateTime @default(now())

  verse           Verse?   @relation(fields: [verseId], references: [id], onDelete: Cascade)
  chapter         Chapter? @relation(fields: [chapterId], references: [id], onDelete: Cascade)

  @@index([verseKey, language])
  @@index([chapterId, language])
}

model DailyVerse {
  id            Int      @id @default(autoincrement())
  dateKey       String   @unique // YYYY-MM-DD
  verseKey      String
  reference     String   // e.g. John 3:16 / యోహాను 3:16
  theme         String
  verseTextEn   String
  verseTextTe   String
  verseTextHi   String
  explanationEn String?
  explanationTe String?
  explanationHi String?
  imageUrl      String?
  audioUrl      String?
  createdAt     DateTime @default(now())

  @@index([dateKey])
}

model Bookmark {
  id            String   @id @default(cuid())
  verseKey      String
  bookName      String
  chapterNumber Int
  verseNumber   Int
  textPreview   String
  language      String   @default("te")
  createdAt     DateTime @default(now())

  @@index([verseKey])
}

model Note {
  id              String   @id @default(cuid())
  verseKey        String
  bookName        String
  chapterNumber   Int
  verseNumber     Int
  contentMarkdown String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([verseKey])
}

model Highlight {
  id        String   @id @default(cuid())
  verseKey  String   @unique
  color     String   @default("gold")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verseKey])
}

model ReadingPlan {
  id            String   @id
  title         String
  titleTelugu   String?
  titleHindi    String?
  durationDays  Int
  category      String
  description   String
  createdAt     DateTime @default(now())
}

model Illustration {
  id                 Int                      @id @default(autoincrement())
  verseId            Int?
  verseKey           String                   // e.g. JHN.3.16
  language           String                   @default("en") // en, te, hi
  imageUrl           String
  thumbnailUrl       String?
  style              String                   @default("vachanam-editorial-handdrawn")
  illustrationType   String                   @default("verse") // biblical_scene, symbolic, character, creation, landscape
  visualMetaphor     String?
  theme              String?
  prompt             String
  negativePrompt     String?
  provider           String                   @default("comfyui") // comfyui, diffusers, openai, fallback
  model              String                   @default("vachanam-visual-engine-v1")
  seed               Int?
  parameters         String?                  // JSON parameters (steps, cfg, sampler, etc.)
  conceptJson        String?                  // Structured Visual Concept
  status             String                   @default("COMPLETED") // PENDING, PROCESSING, COMPLETED, FAILED, REJECTED
  qaStatus           String                   @default("PASSED") // PASSED, FAILED, NEEDS_REVIEW
  aspectRatio        String                   @default("16:9")
  resolution         String                   @default("1024x576")
  cloudinaryPublicId String?
  promptVersion      String                   @default("1.0.0")
  generationVersion  Int                      @default(1)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  verse              Verse?                   @relation(fields: [verseId], references: [id], onDelete: Cascade)
  generations        IllustrationGeneration[]
  qaReviews          IllustrationQA[]

  @@index([verseKey])
  @@index([illustrationType])
  @@index([language])
  @@index([status])
}

model IllustrationGeneration {
  id             Int          @id @default(autoincrement())
  illustrationId Int
  provider       String       @default("openai") // openai, stable-diffusion, fallback
  model          String
  prompt         String
  status         String       @default("COMPLETED")
  errorMessage   String?
  startedAt      DateTime     @default(now())
  completedAt    DateTime?

  illustration   Illustration @relation(fields: [illustrationId], references: [id], onDelete: Cascade)

  @@index([illustrationId])
}

model IllustrationPrompt {
  id             Int      @id @default(autoincrement())
  type           String   // verse, story, concept, character, historical, youth, qa
  version        String   @default("1.0.0")
  systemPrompt   String
  templatePrompt String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type, version])
}

model IllustrationQA {
  id             Int          @id @default(autoincrement())
  illustrationId Int
  contentScore   Float        @default(1.0)
  styleScore     Float        @default(1.0)
  safetyScore    Float        @default(1.0)
  accuracyScore  Float        @default(1.0)
  approved       Boolean      @default(true)
  feedback       String?
  createdAt      DateTime     @default(now())

  illustration   Illustration @relation(fields: [illustrationId], references: [id], onDelete: Cascade)

  @@index([illustrationId])
}

model OutboxEvent {
  id            String    @id @default(cuid())
  eventId       String    @unique
  eventType     String    // e.g. ai.explanation.completed, bible.chapter.updated
  aggregateType String    // e.g. explanation, verse, chapter, diagram, illustration
  aggregateId   String    // e.g. GEN.1.1, JHN.3.16
  payload       String    // JSON payload
  status        String    @default("PENDING") // PENDING, PUBLISHED, FAILED
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  processedAt   DateTime?
  lastError     String?

  @@index([status, createdAt])
  @@index([aggregateType, aggregateId])
}

model AsyncJob {
  id          String    @id @default(cuid())
  jobId       String    @unique
  type        String    // ai-explanation, ai-diagram, illustration, audio, search-index, daily-verse
  status      String    @default("PENDING") // PENDING, QUEUED, RUNNING, PROCESSING, VALIDATING, COMPLETED, FAILED, RETRYING
  progress    Int       @default(0) // 0-100
  stage       String?   // e.g. "Analyzing context", "Generating explanation"
  message     String?
  metadata    String?   // JSON metadata (e.g. verseKey, language)
  result      String?   // JSON result
  error       String?
  retryCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([type, status])
  @@index([jobId])
  @@index([createdAt])
}

model SyncQueueItem {
  id          String    @id @default(cuid())
  operationId String    @unique
  clientId    String?
  entityType  String    // bookmark, note, highlight, reading-progress
  entityId    String
  operation   String    // CREATE, UPDATE, DELETE
  payload     String    // JSON payload
  status      String    @default("PENDING") // PENDING, SYNCED, FAILED
  retryCount  Int       @default(0)
  createdAt   DateTime  @default(now())
  syncedAt    DateTime?
  lastError   String?

  @@index([status, createdAt])
  @@index([clientId])
}


