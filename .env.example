# ==============================================================================
# Vachanam (వచనం • Vachanam • वचन) - Master Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# Database Configuration (PostgreSQL / Supabase compatible)
DATABASE_URL="file:./database/dev.db"

# Server Base URL (Used by Web App)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin & Maintenance Secret Key
ADMIN_API_KEY="vachanam_admin_secret_key_2026"

# Google Gemini / OpenAI AI Model Configuration
GEMINI_API_KEY=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Cloudinary Configuration (For Verse Artworks)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# AWS S3 Storage (For Audio Bible)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET="vachanam-audio-bible"

# Google Cloud TTS
GOOGLE_TTS_API_KEY=""

# Cache & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
CACHE_TTL_SECONDS=3600
