{
  "name": "vachanam",
  "version": "1.0.0",
  "private": true,
  "description": "Vachanam (వచనం • Vachanam • वचन) - Production-Ready Multilingual Digital Bible with AI",
  "workspaces": [
    "frontend",
    "backend",
    "shared",
    "ai-engine"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "start": "concurrently \"npm run start --workspace=backend\" \"npm run start --workspace=frontend\"",
    "db:generate": "prisma generate --schema=database/schema.prisma",
    "db:push": "prisma db push --schema=database/schema.prisma",
    "db:seed": "node scripts/importBible.js",
    "test": "node --test backend/tests/*.test.js && node --test ai-engine/tests/*.test.js",
    "test:ai": "node --test ai-engine/tests/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^5.22.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@tanstack/react-query": "^5.104.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  }
}
